{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^8.0",
        "laravel/jetstream": "^1.2",
        "laravel/sanctum": "^2.6",
        "laravel/tinker": "^2.0",
        "laravelcollective/html": "^6.2",
        "livewire/livewire": "^2.0",
        "maatwebsite/excel": "^3.1",
        "maciejczyzewski/bottomline": "^0.2.0",
        "nfephp-org/sped-common": "^5.1",
        "respect/validation": "^1.1",
        "robrichards/xmlseclibs": "^3.1"
    },
    "require-dev": {
        "facade/ignition": "^2.3.6",
        "fakerphp/faker": "^1.15",
        "lucascudo/laravel-pt-br-localization": "^1.2",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "classmap": [
            "app/ClassesIssnet/Certificado.php",
            "app/ClassesIssnet/DOMImproved.php",
            "app/ClassesIssnet/RenderRPS.php",
            "app/ClassesIssnet/RpsClass.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "FerFabricio\\Hydrator\\": "app/Hydrator",
            "NFePHP\\NFSe\\Models\\Issnet\\": "app/ClassesIssNet",
            "NFePHP\\Common\\": "app/ClassesIssNet",
            "Hadder\\NfseNacional\\": "app/NfseNacional",
            "JCamelo\\NfseNacionalLib\\": "app/NfseNacionalLib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
